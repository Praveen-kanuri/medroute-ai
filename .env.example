## Copy this file to .env and fill in local values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=MedRoute AI
APP_VERSION=0.1.0

# fake = use deterministic fake providers (default, no API keys required)
PROVIDER_MODE=fake

GROQ_API_KEY=
DEEPGRAM_API_KEY=

GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Phase 1D specialty routing (POST /api/v1/navigate). "deterministic"
# (default) uses no-LLM keyword matching only. "groq" additionally tries a
# catalog-validated structured Groq call first (requires GROQ_API_KEY above)
# and falls back to deterministic on any failure.
ROUTING_MODE=deterministic

# Phase 2A voice transcription (POST /api/v1/voice/transcribe). Requires
# GROQ_API_KEY above; the endpoint returns 503 if it is not configured.
GROQ_STT_TIMEOUT_SECONDS=30.0
VOICE_MAX_UPLOAD_BYTES=10000000

# Phase 2B conversational orchestration (POST /api/v1/converse). Text-to-
# speech requires DEEPGRAM_API_KEY above; speech is silently skipped (the
# text response is still returned) if not configured or if synthesis fails.
DEEPGRAM_TTS_TIMEOUT_SECONDS=30.0
TTS_MAX_TEXT_LENGTH=1000

# "deterministic" (default) builds the conversational response from a
# template, no model call. "groq" additionally tries a Groq-backed
# rephrasing first (requires GROQ_API_KEY above), validated for length and
# forbidden medical-claim words, and falls back to deterministic on any
# failure.
RESPONSE_MODE=deterministic

# PostgreSQL (Phase 0.2 persistence foundation). Used by the app, Alembic,
# and Docker Compose's postgres service. Values below are local-dev-only.
POSTGRES_DB=medroute
POSTGRES_USER=medroute
POSTGRES_PASSWORD=medroute_dev_only
DATABASE_URL=postgresql+asyncpg://medroute:medroute_dev_only@localhost:5432/medroute
DATABASE_ECHO=false

# Reserved for a later data milestone. Do not connect to these yet.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
