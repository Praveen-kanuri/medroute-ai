## Copy this file to .env and fill in local values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=MedRoute AI
APP_VERSION=0.1.0

# fake = use deterministic fake providers (default, no API keys required)
PROVIDER_MODE=fake

GROQ_API_KEY=
DEEPGRAM_API_KEY=

GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Reserved for the next data milestone. Do not connect to these yet.
DATABASE_URL=postgresql+asyncpg://medroute:medroute@localhost:5432/medroute
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
