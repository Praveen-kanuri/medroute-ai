## Copy this file to .env and fill in local values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=MedRoute AI
APP_VERSION=0.1.0

# fake = use deterministic fake providers (default, no API keys required)
PROVIDER_MODE=fake

GROQ_API_KEY=
DEEPGRAM_API_KEY=

GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Phase 2D speech-provider fallback: Deepgram is the primary provider for
# both voice transcription and text-to-speech; Groq is the single
# fallback attempt on an eligible transient failure (timeout, connection
# error, rate limiting, temporary unavailability) — never a parallel
# request, and never a second fallback hop back to Deepgram. Only
# "deepgram"/"groq" are recognized.
STT_PRIMARY_PROVIDER=deepgram
STT_FALLBACK_PROVIDER=groq
DEEPGRAM_STT_MODEL=nova-3
GROQ_STT_MODEL=whisper-large-v3-turbo

TTS_PRIMARY_PROVIDER=deepgram
TTS_FALLBACK_PROVIDER=groq
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Phase 1D specialty routing (POST /api/v1/navigate). "deterministic"
# (default) uses no-LLM keyword matching only. "groq" additionally tries a
# catalog-validated structured Groq call first (requires GROQ_API_KEY above)
# and falls back to deterministic on any failure.
ROUTING_MODE=deterministic

# Phase 2A voice transcription (POST /api/v1/voice/transcribe). Requires
# DEEPGRAM_API_KEY and/or GROQ_API_KEY above; the endpoint returns 503 only
# if neither the primary nor fallback provider is configured.
DEEPGRAM_STT_TIMEOUT_SECONDS=30.0
GROQ_STT_TIMEOUT_SECONDS=30.0
VOICE_MAX_UPLOAD_BYTES=10000000

# Phase 2B conversational orchestration (POST /api/v1/converse). Text-to-
# speech requires DEEPGRAM_API_KEY and/or GROQ_API_KEY above; speech is
# silently skipped (the text response is still returned) if neither is
# configured or if synthesis fails.
DEEPGRAM_TTS_TIMEOUT_SECONDS=30.0
GROQ_TTS_TIMEOUT_SECONDS=30.0
TTS_MAX_TEXT_LENGTH=1000

# "deterministic" (default) builds the conversational response from a
# template, no model call. "groq" additionally tries a Groq-backed
# rephrasing first (requires GROQ_API_KEY above), validated for length and
# forbidden medical-claim words, and falls back to deterministic on any
# failure.
RESPONSE_MODE=deterministic

# Phase 3B general-conversation layer. "deterministic" (default): a turn
# that isn't a fixed greeting phrase is always treated as a medical
# concern, unchanged. "groq" additionally asks a Groq-backed classifier
# (requires GROQ_API_KEY above) whether a turn genuinely describes a
# health concern versus general conversation/small talk, and if not,
# composes a warm (also Groq-backed, validated, non-diagnostic) redirect
# reply instead of asking a clarification question that doesn't fit.
# Never consulted for a user-declared emergency turn.
CONVERSATION_MODE=deterministic

# Phase 2C image/video understanding (POST /api/v1/media/analyze).
# "deterministic" (default) never calls a vision model — uploaded media
# still flows through the graph with no visual observations, regardless of
# whether GROQ_API_KEY is set. "groq" additionally requires GROQ_API_KEY
# above to actually attempt a real call. Uploaded media is never
# persisted, and analysis is best-effort — a safe limitation note (never a
# fabricated observation) is returned if it is not enabled/configured or
# fails.
VISION_MODE=deterministic
GROQ_VISION_TIMEOUT_SECONDS=30.0
VISION_MAX_OUTPUT_TOKENS=700
VISION_MAX_OBSERVATIONS=8
IMAGE_MAX_UPLOAD_BYTES=8000000
IMAGE_MAX_DIMENSION_PX=4096
IMAGE_MAX_PIXELS=20000000
VIDEO_MAX_UPLOAD_BYTES=50000000
VIDEO_MAX_DURATION_SECONDS=60.0
VIDEO_MAX_SAMPLED_FRAMES=6
VIDEO_MAX_DIMENSION_PX=4096

# PostgreSQL (Phase 0.2 persistence foundation). Used by the app, Alembic,
# and Docker Compose's postgres service. Values below are local-dev-only.
POSTGRES_DB=medroute
POSTGRES_USER=medroute
POSTGRES_PASSWORD=medroute_dev_only
DATABASE_URL=postgresql+asyncpg://medroute:medroute_dev_only@localhost:5432/medroute
DATABASE_ECHO=false

# Reserved for a later data milestone. Do not connect to these yet.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
